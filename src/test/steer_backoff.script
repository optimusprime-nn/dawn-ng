# A client that keeps returning to the same AP after forced kicks goes into
# steering backoff: it then only gets friendly requests, until it accepts one.
dawn default
dawn min_number_to_kick=1
dawn kicking=1
dawn bandwidth_threshold=0
sim_moves 0
faketime set 1000
ap bssid=11:22:33:44:55:66 neighbors=112233445566
ap bssid=22:33:44:55:66:77 neighbors=223344556677
probe bssid=11:22:33:44:55:66 client=ff:ee:dd:cc:bb:aa signal=-85
probe bssid=22:33:44:55:66:77 client=ff:ee:dd:cc:bb:aa signal=-50
client bssid=11:22:33:44:55:66 client=ff:ee:dd:cc:bb:aa
# 1st forced kick; the client is back on the same AP a minute later: miss 1
kick 11:22:33:44:55:66 0
faketime set 1070
client bssid=11:22:33:44:55:66 client=ff:ee:dd:cc:bb:aa
# 2nd forced kick, same again: miss 2 -> backoff
kick 11:22:33:44:55:66 0
faketime set 1140
client bssid=11:22:33:44:55:66 client=ff:ee:dd:cc:bb:aa
stats_show
# In backoff: only a friendly request, and not again on the next evaluation
kick 11:22:33:44:55:66 0
faketime set 1150
kick 11:22:33:44:55:66 0
stats_show
# The client accepts that request: backoff ends, forced kicks allowed again
btm_response ff:ee:dd:cc:bb:aa 0
faketime set 1160
client bssid=11:22:33:44:55:66 client=ff:ee:dd:cc:bb:aa
kick 11:22:33:44:55:66 0
stats_show
#expect stats: client FF:EE:DD:CC:BB:AA requests=2 moved=0 stayed=2 rejected=0 misses=2 backoff=1
#expect stats: gentle=1 btm_accepted=0 btm_rejected=0 backoffs=1
#expect stats: client FF:EE:DD:CC:BB:AA requests=3 moved=0 stayed=2 rejected=0 misses=2 backoff=1
#expect stats: gentle=1 btm_accepted=1 btm_rejected=0 backoffs=1
#expect stats: client FF:EE:DD:CC:BB:AA requests=4 moved=0 stayed=2 rejected=0 misses=0 backoff=0
